{
  "name": "chappiemojis",
  "version": "1.0.0",
  "description": "Biblioteca local de emojis canônicos por chave semântica + API HTTP em TypeScript puro, sem dependências.",
  "type": "module",
  "main": "dist/library.js",
  "types": "dist/library.d.ts",
  "files": ["dist", "data"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scrape": "node --experimental-strip-types scripts/scrape-emojidb.ts",
    "scrape:write": "node --experimental-strip-types scripts/scrape-emojidb.ts --write"
  },
  "license": "MIT"
}
